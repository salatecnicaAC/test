# ── Proveedor de IA ─────────────────────────────────────────────
# Valores: gemini | openai | openrouter | groq | ollama
# Recomendado gratuito: gemini
AI_PROVIDER=gemini

# Clave del proveedor.
# Gemini (gratis): https://aistudio.google.com/apikey
AI_API_KEY=

# Modelo. Si se omite, se usa el predeterminado del proveedor:
#   gemini -> gemini-3.5-flash-lite
#   openai -> gpt-4o-mini
#   openrouter -> meta-llama/llama-3.3-70b-instruct:free
#   groq -> llama-3.3-70b-versatile
#   ollama -> qwen3:8b
AI_MODEL=gemini-3.5-flash-lite

# Modelos de respaldo separados por comas. Se usan si el principal está
# saturado (503), no existe (404) o alcanza su límite (429).
AI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite

# Endpoint personalizado compatible con OpenAI (opcional).
# AI_BASE_URL=

# Límite de peticiones por minuto y por IP (opcional).
CHAT_RATE_LIMIT=20

# ── Alternativas ────────────────────────────────────────────────
# OpenRouter (modelos :free): AI_PROVIDER=openrouter, OPENROUTER_API_KEY=...
# Groq (nivel gratuito): AI_PROVIDER=groq, GROQ_API_KEY=...
# Ollama local (sin clave): AI_PROVIDER=ollama, AI_MODEL=qwen3:8b
# OpenAI: AI_PROVIDER=openai, AI_API_KEY=sk-...
#
# Variables antiguas compatibles con OpenAI:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=
